# Create an app at https://www.linkedin.com/developers/apps and copy these from its "Auth" tab.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Optional
# LINKEDIN_API_VERSION=202610      # LinkedIn-Version header (YYYYMM). Versions are sunset after ~12 months.
# LINKEDIN_REDIRECT_PORT=8765      # Must match the redirect URL registered on your app: http://127.0.0.1:8765/callback
# LINKEDIN_MCP_HOME=~/.config/linkedin-mcp   # Where the token file is stored

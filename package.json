{
  "name": "@amankumar-2001/linkedin-mcp",
  "version": "0.1.0",
  "description": "MCP server for LinkedIn: read your profile and publish text, link and image posts from Claude or any MCP client.",
  "license": "MIT",
  "author": "Aman Kumar (https://github.com/amankumar-2001)",
  "homepage": "https://github.com/amankumar-2001/linkedin-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amankumar-2001/linkedin-mcp.git"
  },
  "bugs": "https://github.com/amankumar-2001/linkedin-mcp/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "linkedin",
    "claude",
    "mcp-server"
  ],
  "type": "module",
  "bin": {
    "linkedin-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/chmod-bin.mjs",
    "prepare": "npm run build",
    "dev": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "inspect": "npx -y @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
